# Copy to source/.env or export in your shell (never commit .env).
# All settings are optional; QRShield works fully offline without any of them.

QRSHIELD_ENV=development
LOG_LEVEL=INFO

# Required when ALLOWED_HOSTS includes a non-loopback host. Use a random secret of 32+ chars.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QRSHIELD_ACCESS_TOKEN=

# Local OCR settings (no cloud OCR is ever called).
# Supported OCR_PROVIDER values: paddleocr | tesseract | auto
OCR_ENABLED=true
OCR_PROVIDER=paddleocr

# Optional external threat intelligence (VirusTotal v3 URL lookup).
# Even when enabled, every analysis is opt-in ("include_threat_intel=true") and only URLs are queried.
THREAT_INTEL_ENABLED=true
VIRUSTOTAL_API_KEY=
VT_MALICIOUS_THRESHOLD=3
VT_TIMEOUT_SECONDS=10

# Input safety limits and local artifact retention
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE=4000
RESULT_RETENTION_DAYS=7

# Synthetic reference brands/processors (reserved .example domains for legacy unit tests).
# Default is false so live and CLI runs match the locked QRS-Bench-Ind research configuration.
LOAD_SYNTHETIC_REFERENCE=false

# Hostnames the web application answers to (DNS-rebinding protection).
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Optional directory overrides
# ARTIFACTS_DIR=./source/artifacts
# RULES_DIR=./source/rules
